generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  avatar    String?
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Project {
  id               String           @id @default(cuid())
  name             String
  description      String?
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents        Document[]
  flows            Flow[]
  promptCategories PromptCategory[]
  chatSessions     ChatSession[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model Document {
  id        String         @id @default(cuid())
  title     String
  content   String         @db.Text
  fileType  String         // 'pdf' | 'doc' | 'txt' | 'md'
  fileSize  Int
  filePath  String?        // Local file path for uploaded files
  status    DocumentStatus @default(PENDING)
  projectId String
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chunks    DocumentChunk[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([projectId])
  @@index([status])
}

enum DocumentStatus {
  PENDING     // Uploaded, waiting for processing
  PROCESSING  // Currently being parsed/chunked
  EMBEDDING   // Generating embeddings
  READY       // Fully processed, ready for search
  ERROR       // Processing failed
}

model DocumentChunk {
  id         String                   @id @default(cuid())
  content    String                   @db.Text
  chunkIndex Int                      // Position in document (0-based)
  startChar  Int?                     // Start character offset in original document
  endChar    Int?                     // End character offset in original document
  metadata   Json?                    // Additional metadata (page number, heading, etc.)
  embedding  Unsupported("vector(1536)")?  // OpenAI ada-002 embedding dimension
  documentId String
  document   Document                 @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime                 @default(now())

  @@index([documentId])
}

model Flow {
  id           String        @id @default(cuid())
  name         String
  description  String?
  version      Int           @default(1)
  isPublished  Boolean       @default(false)
  variables    Json?         // FlowVariables (session defaults)
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  nodes        FlowNode[]
  edges        FlowEdge[]
  chatSessions ChatSession[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([projectId])
}

model FlowNode {
  id         String   @id @default(cuid())
  nodeId     String   // ReactFlow node ID (e.g., "start-1", "message-abc123")
  type       String   // FlowNodeType
  posX       Float
  posY       Float
  data       Json     // FlowNodeData (type-specific node configuration)
  flowId     String
  flow       Flow     @relation(fields: [flowId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([flowId, nodeId])
  @@index([flowId])
}

model FlowEdge {
  id           String   @id @default(cuid())
  edgeId       String   // ReactFlow edge ID
  source       String   // Source node ID
  target       String   // Target node ID
  sourceHandle String?  // Source handle ID (e.g., "out", "success", "condition-0")
  targetHandle String?  // Target handle ID (e.g., "in")
  label        String?
  animated     Boolean  @default(false)
  flowId       String
  flow         Flow     @relation(fields: [flowId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([flowId, edgeId])
  @@index([flowId])
}

model PromptCategory {
  id          String   @id @default(cuid())
  name        String
  description String?
  isDefault   Boolean  @default(false)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  prompts     Prompt[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Prompt {
  id         String          @id @default(cuid())
  name       String
  isActive   Boolean         @default(false)
  categoryId String
  category   PromptCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  versions   PromptVersion[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model PromptVersion {
  id        String   @id @default(cuid())
  version   Int
  content   String   @db.Text
  promptId  String
  prompt    Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// =============================================================================
// Session & Conversation Models
// =============================================================================

model ChatSession {
  id                String            @id @default(cuid())
  projectId         String
  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  flowId            String
  flow              Flow              @relation(fields: [flowId], references: [id], onDelete: Cascade)
  channel           String            @default("chat") // chat | email | api
  status            SessionStatus     @default(INIT)
  currentNodeId     String?
  variables         Json?             // FlowVariables snapshot at end
  checkpoint        Json?             // SessionCheckpoint
  summary           String?           @db.Text // AI-generated summary
  startedAt         DateTime          @default(now())
  endedAt           DateTime?
  messages          ChatMessage[]
  nodeExecutions    NodeExecution[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([projectId])
  @@index([flowId])
  @@index([status])
}

enum SessionStatus {
  INIT            // 초기화됨
  ACTIVE          // 실행 중
  WAITING_INPUT   // 사용자 입력 대기
  WAITING_HUMAN   // 상담원 대기 (HITL)
  COMPLETED       // 정상 종료
  TIMEOUT         // 타임아웃
  ERROR           // 에러 발생
}

model ChatMessage {
  id          String          @id @default(cuid())
  sessionId   String
  session     ChatSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  direction   MessageDirection
  content     String          @db.Text
  contentType String          @default("text") // text | image | button | card | carousel | link
  metadata    Json?           // Additional metadata
  createdAt   DateTime        @default(now())

  @@index([sessionId])
  @@index([createdAt])
}

enum MessageDirection {
  inbound   // User message
  outbound  // Bot message
}

model NodeExecution {
  id            String        @id @default(cuid())
  sessionId     String
  session       ChatSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  nodeId        String        // ReactFlow node ID
  nodeType      String        // Node type (start, message, etc.)
  turnNumber    Int           // Which turn this execution belongs to
  inputSnapshot Json?         // Variables at node entry
  outputSnapshot Json?        // Node execution result
  status        ExecutionStatus @default(RUNNING)
  errorDetail   String?       @db.Text
  startedAt     DateTime      @default(now())
  endedAt       DateTime?

  @@index([sessionId])
  @@index([nodeId])
  @@index([startedAt])
}

enum ExecutionStatus {
  RUNNING
  SUCCESS
  ERROR
}
